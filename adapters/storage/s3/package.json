  },
  "bugs": {
    "url": "https://github.com/colinmeinke/ghost-storage-adapter-s3/issues"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "aws-sdk": "^2.331.0",
    "ghost-storage-base": "0.0.1"
  },
  "description": "An AWS S3 storage adapter for Ghost 0.10+",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "commitizen": "^2.8.6",
    "cz-conventional-changelog": "^1.2.0",
    "semantic-release": "^15.9.9",
    "snazzy": "^5.0.0",
    "standard": "^8.3.0",
    "travis-deploy-once": "^5.0.2"
  },
  "homepage": "https://github.com/colinmeinke/ghost-storage-adapter-s3#readme",
  "license": "ISC",
  "keywords": [
    "adapter",
    "aws",
    "ghost",
    "s3",
    "storage"
  ],
  "main": "index.js",
  "name": "ghost-storage-adapter-s3",
  "repository": {
    "type": "git",
    "url": "https://github.com/colinmeinke/ghost-storage-adapter-s3.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js",
    "build:ghost": "npm run build && target=\"${GHOST_CORE_CONTENT_DIR:-../../../../00-Ghost-5.116.2/ghost/core/content}/adapters/storage/s3\" && mkdir -p \"$target\" && cp -R dist index.js package.json \"$target/\"",
    "commit": "git-cz",
    "fix": "standard --fix",
    "lint": "standard --verbose | snazzy",
    "prepublishOnly": "npm run build",
    "semantic-release": "semantic-release",
    "test": "node --test test/",
    "travis-deploy-once": "travis-deploy-once"
  },
  "version": "0.0.0-development"
}
